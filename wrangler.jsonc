{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "smcl",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "smcl-db",
			"database_id": "d2151292-5958-4abe-b752-239b0270c675",
			"migrations_dir": "../../migrations",
			// "remote": true
		}
	]
}