---
interface Props {
  name: string;
  placeholder?: string;
  autocomplete?: 'current-password' | 'new-password';
}
const { name, placeholder = 'Password', autocomplete = 'current-password' } = Astro.props;
---

<div class="relative">
  <input
    name={name}
    type="password"
    placeholder={placeholder}
    autocomplete={autocomplete}
    autocapitalize="off"
    autocorrect="off"
    spellcheck="false"
    required
    class="w-full border border-corporate-border rounded-md pl-3 pr-11 py-2"
  />
  <button
    type="button"
    data-password-toggle
    aria-pressed="false"
    aria-label="Tampilkan password"
    title="Tampilkan password"
    class="absolute inset-y-0 right-0 px-3 flex items-center text-slate-500 hover:text-corporate-primary"
  >
    <svg data-icon-show xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
      <circle cx="12" cy="12" r="3" />
    </svg>
    <svg data-icon-hide class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24" />
      <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68" />
      <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61" />
      <line x1="2" x2="22" y1="2" y2="22" />
    </svg>
  </button>
</div>

<script>
  const AUTO_HIDE_MS = 20_000;
  const timers = new WeakMap<HTMLInputElement, number>();

  function setVisible(btn: HTMLButtonElement, input: HTMLInputElement, visible: boolean) {
    input.type = visible ? 'text' : 'password';
    const label = visible ? 'Sembunyikan password' : 'Tampilkan password';
    btn.setAttribute('aria-pressed', String(visible));
    btn.setAttribute('aria-label', label);
    btn.title = label;
    btn.querySelector('[data-icon-show]')?.classList.toggle('hidden', visible);
    btn.querySelector('[data-icon-hide]')?.classList.toggle('hidden', !visible);
    clearTimeout(timers.get(input));
    if (visible) timers.set(input, window.setTimeout(() => setVisible(btn, input, false), AUTO_HIDE_MS));
  }

  const inputOf = (btn: HTMLButtonElement) => btn.parentElement?.querySelector<HTMLInputElement>('input') ?? null;
  const toggleOf = (e: Event) => (e.target as Element).closest<HTMLButtonElement>('[data-password-toggle]');

  // Cegah tombol mengambil fokus dari kolom isian
  document.addEventListener('mousedown', (e) => { if (toggleOf(e)) e.preventDefault(); });

  document.addEventListener('click', (e) => {
    const btn = toggleOf(e);
    const input = btn && inputOf(btn);
    if (!btn || !input) return;
    setVisible(btn, input, input.type === 'password');
    input.focus();
  });

  // Sembunyikan lagi saat tab browser tidak terlihat
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) return;
    document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach((btn) => {
      const input = inputOf(btn);
      if (input?.type === 'text') setVisible(btn, input, false);
    });
  });
</script>
