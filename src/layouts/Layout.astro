---
import '../styles/global.css';

interface Props {
  title?: string;
  customBackground?: boolean;
}

const { title = 'Sistem Manajemen Catatan & Link', customBackground = false} = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="SMCL" />
    <link rel="manifest" href="/site.webmanifest" />
    {customBackground && <link rel="preload" as="image" href="/banner.webp" />}
    <title>{title} | SMCL</title>
  </head>
  <body class="relative isolate bg-corporate-bg text-corporate-dark font-sans min-h-dvh">
    {customBackground && (
      <>
        <div aria-hidden="true"
          class="fixed inset-0 -z-20 scale-105 bg-cover bg-center bg-no-repeat bg-[url('/banner.webp')] blur-sm"></div>
        <div aria-hidden="true" class="fixed inset-0 -z-10 bg-corporate-dark/20"></div>
      </>
    )}
    <slot />
  </body>
</html>
